# ─────────────────────────────────────────────────────────────────────────────
# All optional. Kalshi + Polymarket public read endpoints need NO key.
# Copy to .env.local to override.
# ─────────────────────────────────────────────────────────────────────────────

# DNS-over-HTTPS for Polymarket — for networks that DNS-block polymarket.com
# (e.g. India, where Polymarket is banned at the DNS level but the servers and
# their TLS are reachable). The app resolves Polymarket via DoH and connects by
# IP, so live data works with no VPN.
#   auto = try direct DNS, fall back to DoH on failure  (default; no-op where DNS works)
#   on   = always use DoH for Polymarket
#   off  = never (use snapshot fallback if DNS fails)
POLY_DOH=auto
# DoH resolver endpoint (Cloudflare default; Google: https://dns.google/resolve)
DOH_RESOLVER=https://cloudflare-dns.com/dns-query

# Optional PolyRouter aggregator (reachable where polymarket.com is blocked).
# If set, used as a fallback source for Polymarket before the snapshot.
POLYROUTER_API_KEY=

# Override upstream hosts (e.g. point Polymarket at a reachable proxy/mirror).
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# POLY_GAMMA_URL=https://gamma-api.polymarket.com
# POLY_CLOB_URL=https://clob.polymarket.com

# Demo snapshot fallback for Polymarket when it is fully unreachable.
#   on (default) = serve a clearly-labeled snapshot;  off = show "offline"
POLY_SNAPSHOT=on

# Corpus breadth vs cold-start latency. More pages = more markets browsable but
# a slower first (uncached) load. Kalshi pages are 200 events each; Polymarket
# pages are 100 markets each. Both corpora are cached ~180s after building.
# KALSHI_PAGES=4
# POLY_PAGES=4

# UPSTREAM_TIMEOUT_MS=12000
